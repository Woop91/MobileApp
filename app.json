{
  "expo": {
    "name": "GroupUp",
    "slug": "groupup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a237e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wardis91.groupup",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to scan documents for grievance filings.",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to attach documents to grievance filings.",
        "NSFaceIDUsageDescription": "Face ID is used for quick sign-in to your union dashboard."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a237e"
      },
      "package": "com.wardis91.groupup",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a237e"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "groupup",
    "extra": {
      "eas": {
        "projectId": "6d9ed93c-69fb-464e-bd33-67730c7eecbc"
      }
    },
    "owner": "wardis91"
  }
}
