{
  "expo": {
    "name": "DDS Dashboard",
    "slug": "dds-dashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a237e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seiu509.ddsdashboard",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to scan documents for grievance filings.",
        "NSPhotoLibraryUsageDescription": "Photo library access is needed to attach documents to grievance filings.",
        "NSFaceIDUsageDescription": "Face ID is used for quick sign-in to your union dashboard."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a237e"
      },
      "package": "com.seiu509.ddsdashboard",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "NOTIFICATIONS", "USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a237e"
        }
      ]
    ],
    "scheme": "ddsdashboard",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
